# Copy to .env and fill every required value before starting Pi Web.
# Full image reference built by your registry, including its tag.
PI_WEB_IMAGE=

# Long, unique browser password. The Basic Auth username is always "pi".
PI_WEB_PASSWORD=

# Host-side port. Pi Web listens on 30141 inside the container.
PI_WEB_PORT=30141

# Comma-separated exact hostnames forwarded by the reverse proxy.
# Required by docker-compose.yml; use the public hostname, without scheme or path.
PI_WEB_ALLOWED_HOSTS=

# Host workspace bind-mounted into the container. Keep both paths the same
# when reopening sessions whose saved working directories use this absolute path.
WORKSPACE_DIR=./workspace
WORKSPACE_CONTAINER_DIR=/workspace
